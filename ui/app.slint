// Simple Player for Windows — main window and the detachable player window.
// Own design: custom title bar, a left rail, a card-style track list, a now-playing
// column with large lyrics, and a floating transport dock. Every control is drawn here.

import { ListView, AboutSlint } from "std-widgets.slint";
import { Icon } from "icons.slint";
import {
    Palette, LyricLine, Glyph, Pill, Toggle, Slider, SearchBox, Field, Art, PlayingMark, HeaderCell,
    SectionLabel, WinButton, ResizeBorders, PlayButton, NowPanel, ScrollThumb, Lang } from "common.slint";

export { Palette, LyricLine, Lang } from "common.slint";
export { MiniWindow, MiniRow } from "mini.slint";

export struct SourceItem {
    label: string,
    count: string,
    icon: string,
    header: bool,
}

// one band of the equalizer as shown: slider positions 0..1 and the values as text
export struct EqBandRow {
    kind: int, // 0 low shelf, 1 peak, 2 high shelf
    freq: float,
    gain: float,
    q: float,
    freq-text: string,
    gain-text: string,
    q-text: string,
}

// a band's marker on the response curve (0..1 across / down)
export struct EqDot {
    x: float,
    y: float,
}

export struct TrackRow {
    num: string,
    title: string,
    artist: string,
    album: string,
    format: string,
    duration: string,
    origin: string,
    playing: bool,
}

export component MainWindow inherits Window {
    title: "Simple Player";
    no-frame: true;
    always-on-top: root.pinned;
    preferred-width: 1300px;
    preferred-height: 820px;
    min-width: 1000px;
    min-height: 620px;
    background: Palette.bg;
    default-font-size: 12px;
    default-font-family: "Segoe UI";

    // sidebar
    in property <[SourceItem]> sources;
    in-out property <int> selected-source: -1;
    callback source-clicked(int);

    // list
    in property <[TrackRow]> tracks;
    in-out property <int> selected-row: -1;
    in property <int> sort-column: -1;
    in property <bool> sort-asc: true;
    in property <string> list-title: (Lang.en ? "All songs" : "全部歌曲");
    in property <string> list-info;
    in property <bool> empty-library: false;
    callback row-activated(int);
    callback sort-by(int);
    callback search-changed(string);

    // now playing
    in property <string> now-title: (Lang.en ? "Nothing playing" : "尚未播放");
    in property <string> now-artist: (Lang.en ? "Pick a song to start" : "選一首歌開始播放");
    in property <string> now-album;
    in property <string> now-detail;
    in property <image> cover-image;
    in property <bool> has-cover: false;
    in property <bool> playing: false;
    in property <float> progress: 0;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in-out property <float> volume: 0.8;
    property <float> volume-before-mute: 0.8;
    in property <[LyricLine]> lyrics;
    in property <int> active-lyric: -1;
    in property <string> lyrics-state: (Lang.en ? "Waiting" : "等待播放");
    in property <bool> switching: false;
    callback toggle-play();
    callback prev();
    callback next();
    callback seek(float);
    callback volume-changed(float);
    callback lyric-clicked(int);

    // settings / about
    in-out property <bool> show-settings: false;
    in-out property <bool> show-about: false;
    in-out property <string> server-url;
    in-out property <string> public-url;
    in property <[string]> folders;
    in-out property <bool> discord-enabled: true;
    in property <string> server-status;
    in property <string> discord-status;
    in property <string> status-text;
    callback save-server(string);
    callback save-public-url(string);
    callback add-folder();
    callback remove-folder(int);
    callback rescan();
    callback discord-toggled(bool);
    callback theme-toggled(bool);
    // theme colour: "#rrggbb" from a swatch or the custom field
    callback accent-picked(string);
    // playback modes, queue, tray
    in property <bool> shuffle: false;
    in property <int> repeat-mode: 0; // 0 off, 1 all, 2 one
    in property <bool> queue-view: false;
    in-out property <bool> close-to-tray: true;
    // false on macOS: menu bar instead of tray, native-rate output instead of WASAPI
    in property <bool> is-windows: true;
    // audio output devices; index 0 = system default
    in property <[string]> output-devices: [(Lang.en ? "System default" : "系統預設")];
    in-out property <int> output-index: 0;
    callback output-picked(int);
    in-out property <bool> exclusive: false;
    in property <string> output-status;
    callback exclusive-toggled(bool);
    in-out property <int> buffer-level: 1;
    callback buffer-picked(int);
    in-out property <int> replaygain-mode: 0;
    callback replaygain-picked(int);
    callback settings-opened();

    // equalizer
    in-out property <bool> show-eq: false;
    in property <bool> eq-enabled: false;
    in property <[string]> eq-presets;
    in property <int> eq-current: 0;
    in property <float> eq-preamp: 0.77;
    in property <string> eq-preamp-text: "0.0 dB";
    in property <[EqBandRow]> eq-bands;
    in property <string> eq-curve: "M 0 150 L 1000 150";
    in property <[EqDot]> eq-dots;
    in property <string> eq-message;
    in property <int> eq-max-bands: 10;
    // -1 none, 0 naming a new preset, 1 renaming, 2 confirming a delete
    in-out property <int> eq-dialog: -1;
    in-out property <string> eq-name;
    callback eq-opened();
    callback eq-toggled(bool);
    callback eq-select(int);
    callback eq-name-done(int, string);
    callback eq-delete();
    callback eq-import();
    callback eq-export();
    callback eq-preamp-moving(float);
    callback eq-preamp-committed(float);
    callback eq-auto-preamp();
    callback eq-band-kind(int, int);
    // band, what (0 frequency, 1 gain, 2 Q), slider position 0..1
    callback eq-band-moving(int, int, float);
    callback eq-band-committed(int, int, float);
    callback eq-band-delete(int);
    callback eq-band-add();
    changed show-eq => {
        if (root.show-eq) { root.eq-opened(); }
    }
    changed show-settings => {
        if (root.show-settings) { root.settings-opened(); }
    }
    callback toggle-shuffle();
    callback cycle-repeat();
    callback seek-by(float);
    callback volume-by(float);
    callback queue-add(int);
    callback queue-remove(int);
    callback close-to-tray-toggled(bool);
    // language (false = 繁體中文, true = English) and updates
    callback language-picked(bool);
    in-out property <bool> auto-update: true;
    callback auto-update-toggled(bool);
    in property <bool> update-available: false;
    in property <string> update-url: "https://github.com/Akiraoo/SimplePlayer-Desktop-APP/releases";
    in property <string> update-status;
    in property <bool> update-checking: false;
    callback check-update();
    callback open-url(string);
    public function refocus() { keys.focus(); }
    // bring row i into view (rows are 52 px high)
    public function scroll-to-row(i: int) {
        track-list.content-y = min(0px, max(track-list.visible-height - track-list.content-height,
            track-list.visible-height / 2 - (i + 0.5) * 52px));
    }
    in property <string> app-version: "0.0.0";
    in-out property <string> accent-hex: "#f2a65a";

    // custom title bar / frameless window
    in property <bool> is-max: false;
    in-out property <bool> pinned: false;
    in-out property <bool> detached: false;
    callback pin-toggled(bool);
    callback detach-toggled(bool);
    callback win-drag();
    callback win-minimize();
    callback win-maximize();
    callback win-close();
    callback win-resize(int); // 0 N, 1 NE, 2 E, 3 SE, 4 S, 5 SW, 6 W, 7 NW


    VerticalLayout {
        /* ---------- title bar ---------- */
        Rectangle {
            height: 42px;
            background: Palette.titlebar;
            TouchArea {
                // Start the system move only once the mouse moves, so double-click still works.
                moved => {
                    if (self.pressed) { root.win-drag(); }
                }
                double-clicked => { root.win-maximize(); }
            }
            HorizontalLayout {
                padding-left: 14px;
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Image { width: 20px; height: 20px; source: @image-url("../assets/icon-small.png"); }
                }
                Text {
                    text: "Simple Player";
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.text;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Rectangle { horizontal-stretch: 1; min-width: 12px; }
                VerticalLayout {
                    alignment: center;
                    search := SearchBox {
                        width: 320px;
                        height: 30px;
                        edited(t) => { root.search-changed(t); }
                        escape => { keys.focus(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; min-width: 12px; }
                VerticalLayout {
                    alignment: center;
                    Glyph {
                        size: 30px;
                        icon-size: 18px;
                        icon: Palette.light ? "moon" : "sun";
                        clicked => {
                            Palette.light = !Palette.light;
                            root.theme-toggled(Palette.light);
                        }
                    }
                }
                VerticalLayout { alignment: center; Glyph { size: 30px; icon-size: 18px; icon: "refresh"; clicked => { root.rescan(); } } }
                VerticalLayout { alignment: center; Glyph { size: 30px; icon-size: 18px; icon: "eq"; active: root.show-eq || root.eq-enabled; clicked => { root.show-eq = true; } } }
                VerticalLayout { alignment: center; Glyph { size: 30px; icon-size: 18px; icon: "settings"; active: root.show-settings; clicked => { root.show-settings = true; } } }
                VerticalLayout { alignment: center; Glyph { size: 30px; icon-size: 18px; icon: "info"; badge: root.update-available ? "!" : ""; active: root.show-about; clicked => { root.show-about = true; } } }
                Rectangle { width: 6px; }
                VerticalLayout {
                    alignment: center;
                    Glyph {
                        size: 30px;
                        icon-size: 18px;
                        icon: "detach";
                        active: root.detached;
                        clicked => {
                            root.detached = !root.detached;
                            root.detach-toggled(root.detached);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Glyph {
                        size: 30px;
                        icon-size: 18px;
                        icon: "pin";
                        active: root.pinned;
                        clicked => {
                            root.pinned = !root.pinned;
                            root.pin-toggled(root.pinned);
                        }
                    }
                }
                Rectangle { width: 10px; }
                Rectangle {
                    width: 1px;
                    Rectangle { y: 12px; height: parent.height - 24px; background: Palette.line; }
                }
                Rectangle { width: 6px; }
                WinButton { icon: "win-min"; clicked => { root.win-minimize(); } }
                WinButton { icon: root.is-max ? "win-restore" : "win-max"; clicked => { root.win-maximize(); } }
                WinButton { icon: "win-close"; danger: true; clicked => { root.win-close(); } }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            /* ---------- left rail ---------- */
            Rectangle {
                width: 236px;
                background: Palette.rail;
                VerticalLayout {
                    padding-top: 6px;
                    Rectangle {
                        vertical-stretch: 1;
                        rail-list := ListView {
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            for s[i] in root.sources: Rectangle {
                                height: s.header ? 34px : 38px;
                                if !s.header: Rectangle {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    y: 2px;
                                    height: parent.height - 4px;
                                    border-radius: 10px;
                                    background: i == root.selected-source ? Palette.accent-soft : (sta.has-hover ? Palette.hover : transparent);
                                }
                                HorizontalLayout {
                                    padding-left: s.header ? 20px : 20px;
                                    padding-right: 20px;
                                    padding-top: s.header ? 14px : 0px;
                                    spacing: 10px;
                                    if !s.header: VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            name: s.icon;
                                            size: 18px;
                                            color: i == root.selected-source ? Palette.accent : Palette.muted;
                                            line: 1.7px;
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: s.label;
                                        color: s.header ? Palette.faint : (i == root.selected-source ? Palette.strong : Palette.text);
                                        font-size: s.header ? 10px : 12px;
                                        font-weight: s.header ? 700 : (i == root.selected-source ? 600 : 400);
                                        letter-spacing: s.header ? 1.2px : 0px;
                                        vertical-alignment: TextVerticalAlignment.center;
                                        overflow: TextOverflow.elide;
                                    }
                                    if !s.header: Text {
                                        text: s.count;
                                        color: i == root.selected-source ? Palette.accent : Palette.faint;
                                        font-size: 10px;
                                        vertical-alignment: TextVerticalAlignment.center;
                                    }
                                }
                                sta := TouchArea {
                                    enabled: !s.header;
                                    mouse-cursor: pointer;
                                    clicked => { root.source-clicked(i); }
                                }
                            }
                        }
                        ScrollThumb {
                            x: parent.width - self.width;
                            height: parent.height;
                            content-h: rail-list.content-height;
                            view-h: rail-list.visible-height;
                            content-y <=> rail-list.content-y;
                        }
                    }
                }
            }

            /* ---------- library ---------- */
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.bg;
                VerticalLayout {
                    padding-left: 22px;
                    padding-right: 18px;
                    padding-top: 12px;
                    // header
                    HorizontalLayout {
                        height: 62px;
                        spacing: 14px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 4px;
                            Text { text: root.list-title; font-size: 24px; font-weight: 700; color: Palette.strong; overflow: TextOverflow.elide; }
                            Text { text: root.list-info; font-size: 11px; color: Palette.muted; }
                        }
                    }
                    // column header
                    HorizontalLayout {
                        height: 34px;
                        padding-left: 10px;
                        padding-right: 14px;
                        spacing: 12px;
                        HeaderCell { width: 30px; label: "#"; column: 0; align: TextHorizontalAlignment.center; sort-column: root.sort-column; sort-asc: root.sort-asc; sort(c) => { root.sort-by(c); } }
                        HeaderCell { preferred-width: 0px; min-width: 0px; horizontal-stretch: 5; label: (Lang.en ? "Title" : "標題"); column: 1; sort-column: root.sort-column; sort-asc: root.sort-asc; sort(c) => { root.sort-by(c); } }
                        HeaderCell { preferred-width: 0px; min-width: 0px; horizontal-stretch: 3; label: (Lang.en ? "Album" : "專輯"); column: 3; sort-column: root.sort-column; sort-asc: root.sort-asc; sort(c) => { root.sort-by(c); } }
                        HeaderCell { width: 54px; label: (Lang.en ? "Format" : "格式"); column: 5; align: TextHorizontalAlignment.center; sort-column: root.sort-column; sort-asc: root.sort-asc; sort(c) => { root.sort-by(c); } }
                        HeaderCell { width: 52px; label: (Lang.en ? "Time" : "時長"); column: 4; align: TextHorizontalAlignment.right; sort-column: root.sort-column; sort-asc: root.sort-asc; sort(c) => { root.sort-by(c); } }
                        HeaderCell { width: 22px; label: ""; column: 6; sort-column: root.sort-column; sort-asc: root.sort-asc; sort(c) => { root.sort-by(c); } }
                    }
                    Rectangle { height: 1px; background: Palette.line; }
                    Rectangle {
                        vertical-stretch: 1;
                        track-list := ListView {
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            for row[i] in root.tracks: Rectangle {
                                height: 52px;
                                Rectangle {
                                    y: 2px;
                                    height: parent.height - 4px;
                                    border-radius: 10px;
                                    background: row.playing ? Palette.accent-soft
                                        : (i == root.selected-row ? Palette.press : (rta.has-hover ? Palette.hover : transparent));
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 30px;
                                        if row.playing: PlayingMark {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        if !row.playing: Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: row.num;
                                            color: Palette.faint;
                                            font-size: 11px;
                                            horizontal-alignment: TextHorizontalAlignment.center;
                                            vertical-alignment: TextVerticalAlignment.center;
                                        }
                                    }
                                    VerticalLayout {
                                        preferred-width: 0px;
                                        min-width: 0px;
                                        horizontal-stretch: 5;
                                        alignment: center;
                                        spacing: 3px;
                                        Text { text: row.title; color: row.playing ? Palette.accent : Palette.strong; font-size: 13px; font-weight: row.playing ? 650 : 500; overflow: TextOverflow.elide; }
                                        Text { text: row.artist; color: Palette.muted; font-size: 11px; overflow: TextOverflow.elide; }
                                    }
                                    Text { preferred-width: 0px; min-width: 0px; horizontal-stretch: 3; text: row.album; color: Palette.muted; font-size: 11px; vertical-alignment: TextVerticalAlignment.center; overflow: TextOverflow.elide; }
                                    Rectangle {
                                        width: 54px;
                                        if row.format != "": Rectangle {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: fmt.preferred-width + 12px;
                                            height: 18px;
                                            border-radius: 9px;
                                            border-width: 1px;
                                            border-color: Palette.line;
                                            fmt := Text {
                                                text: row.format;
                                                color: Palette.muted;
                                                font-size: 9px;
                                                font-weight: 600;
                                                letter-spacing: 0.6px;
                                                horizontal-alignment: TextHorizontalAlignment.center;
                                                vertical-alignment: TextVerticalAlignment.center;
                                            }
                                        }
                                    }
                                    Text { width: 52px; text: row.duration; color: Palette.muted; font-size: 11px; horizontal-alignment: TextHorizontalAlignment.right; vertical-alignment: TextVerticalAlignment.center; }
                                    Rectangle {
                                        width: 22px;
                                        Icon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            name: row.origin;
                                            size: 16px;
                                            color: Palette.faint;
                                            line: 1.6px;
                                        }
                                    }
                                }
                                rta := TouchArea {
                                    mouse-cursor: pointer;
                                    // One click plays (double-clicks are hard with a drifting VR cursor).
                                    clicked => {
                                        root.selected-row = i;
                                        root.row-activated(i);
                                        keys.focus();
                                    }
                                }
                                // hover action: add to queue (queue view: remove)
                                // (Only the topmost area reports hover, so the pill also stays
                                // visible while the pointer is on its own buttons.)
                                Rectangle {
                                    visible: (rta.has-hover || act.has-hover || g-add.hovered || g-del.hovered)
                                        && !(root.queue-view && row.playing);
                                    x: parent.width - self.width - 6px;
                                    y: (parent.height - self.height) / 2;
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: Palette.raised;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: #00000030;
                                    act := TouchArea {}
                                    g-add := Glyph {
                                        x: 4px;
                                        y: 4px;
                                        visible: !root.queue-view;
                                        size: 28px;
                                        icon-size: 16px;
                                        icon: "plus";
                                        clicked => { root.queue-add(i); }
                                    }
                                    g-del := Glyph {
                                        x: 4px;
                                        y: 4px;
                                        visible: root.queue-view;
                                        size: 28px;
                                        icon-size: 16px;
                                        icon: "close";
                                        clicked => { root.queue-remove(i); }
                                    }
                                }
                            }
                        }
                        ScrollThumb {
                            x: parent.width - self.width;
                            height: parent.height;
                            content-h: track-list.content-height;
                            view-h: track-list.visible-height;
                            content-y <=> track-list.content-y;
                        }

                        // empty state
                        if root.empty-library: Rectangle {
                            background: Palette.bg;
                            VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                HorizontalLayout {
                                    alignment: center;
                                    Image { width: 72px; height: 72px; source: @image-url("../assets/icon.png"); }
                                }
                                Text { text: (Lang.en ? "No music here yet" : "這裡還沒有音樂"); color: Palette.strong; font-size: 16px; font-weight: 700; horizontal-alignment: TextHorizontalAlignment.center; }
                                Text { text: (Lang.en ? "Add a music folder from this PC, or connect to your Simple Player server." : "加入電腦裡的音樂資料夾，或連上你的 Simple Player 伺服器。"); color: Palette.muted; horizontal-alignment: TextHorizontalAlignment.center; }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding-top: 4px;
                                    Pill { label: (Lang.en ? "Add folder" : "加入資料夾"); icon: "folder"; primary: true; clicked => { root.add-folder(); } }
                                    Pill { label: (Lang.en ? "Connect server" : "連線伺服器"); icon: "cloud"; clicked => { root.show-settings = true; } }
                                }
                            }
                        }
                    }
                    Text {
                        height: 26px;
                        text: root.status-text;
                        color: Palette.faint;
                        font-size: 10px;
                        vertical-alignment: TextVerticalAlignment.center;
                        overflow: TextOverflow.elide;
                    }
                }
            }

            /* ---------- now playing (slides away when detached) ---------- */
            Rectangle {
                width: root.detached ? 0px : 320px;
                animate width { duration: 300ms; easing: ease-in-out; }
                clip: true;
                background: Palette.surface;
                NowPanel {
                    x: 0;
                    width: 320px;
                    height: parent.height;
                    opacity: root.detached ? 0 : 1;
                    animate opacity { duration: 200ms; }
                    cover-image: root.cover-image;
                    has-cover: root.has-cover;
                    now-title: root.now-title;
                    now-artist: root.now-artist;
                    now-album: root.now-album;
                    now-detail: root.now-detail;
                    lyrics: root.lyrics;
                    active-lyric: root.active-lyric;
                    lyrics-state: root.lyrics-state;
                    switching: root.switching;
                    lyric-clicked(i) => { root.lyric-clicked(i); }
                }
            }
        }

        /* ---------- transport dock ---------- */
        Rectangle {
            height: 92px;
            background: Palette.bg;
            Rectangle {
                x: 12px;
                y: 8px;
                width: parent.width - 24px;
                height: parent.height - 18px;
                border-radius: 18px;
                background: Palette.raised;
                border-width: 1px;
                border-color: Palette.line;
                drop-shadow-blur: 18px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #0000002e;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 18px;
                    spacing: 18px;

                    HorizontalLayout {
                        width: 290px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Art {
                                width: 52px;
                                height: 52px;
                                radius: 12px;
                                opacity: root.switching ? 0 : 1;
                                animate opacity { duration: 220ms; easing: ease-in-out; }
                                source: root.cover-image;
                                has-image: root.has-cover;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text { text: root.now-title; color: Palette.strong; font-size: 13px; font-weight: 650; overflow: TextOverflow.elide;
                                opacity: root.switching ? 0 : 1; animate opacity { duration: 200ms; } }
                            Text { text: root.now-artist; color: Palette.muted; font-size: 11px; overflow: TextOverflow.elide;
                                opacity: root.switching ? 0 : 1; animate opacity { duration: 200ms; } }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 18px;
                            VerticalLayout { alignment: center; Glyph { icon: "shuffle"; icon-size: 18px; size: 34px; active: root.shuffle; clicked => { root.toggle-shuffle(); } } }
                            VerticalLayout { alignment: center; Glyph { icon: "prev"; icon-size: 16px; size: 34px; clicked => { root.prev(); } } }
                            PlayButton { playing: root.playing; clicked => { root.toggle-play(); } }
                            VerticalLayout { alignment: center; Glyph { icon: "next"; icon-size: 16px; size: 34px; clicked => { root.next(); } } }
                            VerticalLayout { alignment: center; Glyph { icon: "repeat"; icon-size: 18px; size: 34px; active: root.repeat-mode > 0; badge: root.repeat-mode == 2 ? "1" : ""; clicked => { root.cycle-repeat(); } } }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { width: 42px; text: root.position-text; color: Palette.muted; font-size: 10px; horizontal-alignment: TextHorizontalAlignment.right; vertical-alignment: TextVerticalAlignment.center; }
                            Slider {
                                horizontal-stretch: 1;
                                value: root.progress;
                                committed(v) => { root.seek(v); }
                            }
                            Text { width: 42px; text: root.duration-text; color: Palette.muted; font-size: 10px; vertical-alignment: TextVerticalAlignment.center; }
                        }
                    }

                    HorizontalLayout {
                        width: 190px;
                        alignment: end;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Glyph {
                                icon: root.volume <= 0.001 ? "mute" : "volume";
                                size: 30px;
                                icon-size: 18px;
                                clicked => {
                                    if (root.volume > 0.001) {
                                        root.volume-before-mute = root.volume;
                                        root.volume = 0;
                                    } else {
                                        root.volume = max(0.05, root.volume-before-mute);
                                    }
                                    root.volume-changed(root.volume);
                                }
                            }
                        }
                        Rectangle {
                            width: 120px;
                            Slider {
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                value: root.volume;
                                moving(v) => { root.volume = v; root.volume-changed(v); }
                                committed(v) => { root.volume = v; root.volume-changed(v); }
                            }
                        }
                    }
                }
            }
        }
    }

    /* ---------- keyboard shortcuts ---------- */
    // Space play/pause · ←/→ seek 5 s · Ctrl+←/→ previous/next song · ↑/↓ volume
    // Ctrl+F search · S shuffle · R repeat · Esc close dialogs
    init => { keys.focus(); }
    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(e) => {
            if (e.text == " ") { root.toggle-play(); return accept; }
            if (e.text == Key.LeftArrow) {
                if (e.modifiers.control) { root.prev(); } else { root.seek-by(-5); }
                return accept;
            }
            if (e.text == Key.RightArrow) {
                if (e.modifiers.control) { root.next(); } else { root.seek-by(5); }
                return accept;
            }
            if (e.text == Key.UpArrow) { root.volume-by(0.05); return accept; }
            if (e.text == Key.DownArrow) { root.volume-by(-0.05); return accept; }
            if (e.modifiers.control && (e.text == "f" || e.text == "F")) { search.focus-input(); return accept; }
            if (!e.modifiers.control && (e.text == "s" || e.text == "S")) { root.toggle-shuffle(); return accept; }
            if (!e.modifiers.control && (e.text == "r" || e.text == "R")) { root.cycle-repeat(); return accept; }
            if (e.text == Key.Escape) {
                root.show-settings = false;
                root.show-about = false;
                root.show-eq = false;
                return accept;
            }
            return reject;
        }
    }

    /* ---------- resize borders (frameless window) ---------- */
    if !root.is-max: ResizeBorders {
        width: parent.width;
        height: parent.height;
        resize(d) => { root.win-resize(d); }
    }

    /* ---------- settings ---------- */
    if root.show-settings: Rectangle {
        background: Palette.scrim;
        TouchArea { clicked => { root.show-settings = false; keys.focus(); } }
        Rectangle {
            width: 600px;
            height: min(parent.height - 40px, 740px);
            border-radius: 18px;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.line;
            drop-shadow-blur: 40px;
            drop-shadow-color: #00000070;
            TouchArea {}
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: (Lang.en ? "Settings" : "設定"); font-size: 20px; font-weight: 700; color: Palette.strong; vertical-alignment: TextVerticalAlignment.center; }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; Glyph { icon: "close"; clicked => { root.show-settings = false; keys.focus(); } } }
                }
                Rectangle {
                    vertical-stretch: 1;
                    settings-scroll := Flickable {
                        content-height: settings-col.preferred-height;
                        settings-col := VerticalLayout {
                            // leave a gutter for the scrollbar
                            width: settings-scroll.width - 12px;
                            spacing: 10px;

                            // general: language, updates
                            Rectangle {
                                border-radius: 12px;
                                background: Palette.raised;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Text { text: "語言 / Language"; color: Palette.strong; font-weight: 600; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 186px;
                                                height: 30px;
                                                border-radius: 15px;
                                                background: Palette.bg;
                                                border-width: 1px;
                                                border-color: Palette.line;
                                                HorizontalLayout {
                                                    padding: 3px;
                                                    spacing: 2px;
                                                    for opt[i] in ["繁體中文", "English"]: Rectangle {
                                                        property <bool> on: (i == 1) == Lang.en;
                                                        border-radius: 12px;
                                                        background: self.on ? Palette.accent : (lgta.has-hover ? Palette.hover : transparent);
                                                        Text {
                                                            text: opt;
                                                            color: parent.on ? Palette.accent-text : Palette.text;
                                                            font-size: 11px;
                                                            font-weight: parent.on ? 600 : 400;
                                                            horizontal-alignment: TextHorizontalAlignment.center;
                                                            vertical-alignment: TextVerticalAlignment.center;
                                                        }
                                                        lgta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.language-picked(i == 1); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Palette.line; }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text { text: Lang.en ? "Check for updates on start" : "啟動時自動檢查更新"; color: Palette.strong; font-weight: 600; }
                                            Text {
                                                text: Lang.en ? "Looks for a newer release on GitHub; nothing is downloaded or installed by itself." : "到 GitHub 查有沒有新版本；不會自己下載或安裝。";
                                                color: Palette.muted;
                                                font-size: 10px;
                                                wrap: TextWrap.word-wrap;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Toggle {
                                                checked <=> root.auto-update;
                                                toggled(on) => { root.auto-update-toggled(on); }
                                            }
                                        }
                                    }
                                }
                            }

                            // theme colour
                            Rectangle {
                                border-radius: 12px;
                                background: Palette.raised;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    SectionLabel { text: (Lang.en ? "Theme colour (accent only; light/dark stays as set)" : "主題色（只換強調色，深淺色不受影響）"); }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        for sw in [
                                            { c: #f2a65a, hex: "#f2a65a" },
                                            { c: #ff7a6b, hex: "#ff7a6b" },
                                            { c: #f472b6, hex: "#f472b6" },
                                            { c: #a78bfa, hex: "#a78bfa" },
                                            { c: #60a5fa, hex: "#60a5fa" },
                                            { c: #2dd4bf, hex: "#2dd4bf" },
                                            { c: #4ade80, hex: "#4ade80" },
                                            { c: #facc15, hex: "#facc15" },
                                        ]: VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 26px;
                                                height: 26px;
                                                border-radius: 13px;
                                                background: sw.c;
                                                border-width: Palette.accent-base == sw.c ? 3px : (swta.has-hover ? 2px : 0px);
                                                border-color: Palette.light ? #ffffff : #17181a;
                                                Rectangle {
                                                    visible: Palette.accent-base == sw.c;
                                                    width: parent.width + 4px;
                                                    height: parent.height + 4px;
                                                    border-radius: self.width / 2;
                                                    border-width: 2px;
                                                    border-color: sw.c;
                                                }
                                                swta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.accent-hex = sw.hex;
                                                        root.accent-picked(sw.hex);
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Field {
                                            width: 110px;
                                            text <=> root.accent-hex;
                                            placeholder: "#rrggbb";
                                            accepted(t) => { root.accent-picked(t); }
                                        }
                                        VerticalLayout { alignment: center; Pill { label: (Lang.en ? "Apply" : "套用"); clicked => { root.accent-picked(root.accent-hex); } } }
                                    }
                                    Rectangle { height: 1px; background: Palette.line; }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: root.is-windows
                                                    ? (Lang.en ? "Close to the system tray" : "關閉視窗時縮到系統列")
                                                    : (Lang.en ? "Close to the menu bar" : "關閉視窗時縮到選單列");
                                                color: Palette.strong;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: root.is-windows
                                                    ? (Lang.en ? "The close button keeps playing in the background; choose Quit in the tray icon menu to exit." : "按關閉鈕後繼續在背景播放；從系統列圖示的選單「結束」才會完全關閉。")
                                                    : (Lang.en ? "The close button keeps playing in the background; choose Quit in the menu bar icon's menu (or ⌘Q) to exit." : "按關閉鈕後繼續在背景播放；從選單列圖示的選單「結束」（或 ⌘Q）才會完全關閉。");
                                                color: Palette.muted;
                                                font-size: 10px;
                                                overflow: TextOverflow.elide;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Toggle {
                                                checked <=> root.close-to-tray;
                                                toggled(on) => { root.close-to-tray-toggled(on); }
                                            }
                                        }
                                    }
                                }
                            }

                            // audio output
                            Rectangle {
                                border-radius: 12px;
                                background: Palette.raised;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout { alignment: center; Icon { name: "volume"; size: 16px; color: Palette.accent; } }
                                        SectionLabel { text: (Lang.en ? "Audio output device" : "音訊輸出裝置"); vertical-alignment: TextVerticalAlignment.center; }
                                    }
                                    // drop-down: shows the chosen device, the list opens in a popup
                                    out-btn := Rectangle {
                                        height: 36px;
                                        border-radius: 9px;
                                        background: obta.has-hover ? Palette.hover : Palette.bg;
                                        border-width: 1px;
                                        border-color: Palette.line;
                                        Text {
                                            x: 12px;
                                            width: parent.width - 44px;
                                            height: parent.height;
                                            text: root.output-devices[root.output-index];
                                            color: Palette.text;
                                            vertical-alignment: TextVerticalAlignment.center;
                                            overflow: TextOverflow.elide;
                                        }
                                        Icon {
                                            x: parent.width - 28px;
                                            y: (parent.height - self.height) / 2;
                                            name: "chevron-down";
                                            size: 16px;
                                            color: Palette.muted;
                                        }
                                        obta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { out-popup.show(); }
                                        }
                                        out-popup := PopupWindow {
                                            x: 0;
                                            y: parent.height + 4px;
                                            width: parent.width;
                                            height: min(260px, root.output-devices.length * 34px + 10px);
                                            Rectangle {
                                                border-radius: 10px;
                                                background: Palette.raised;
                                                border-width: 1px;
                                                border-color: Palette.line;
                                                clip: true;
                                                dev-flick := Flickable {
                                                    x: 5px;
                                                    y: 5px;
                                                    width: parent.width - 10px;
                                                    height: parent.height - 10px;
                                                    content-height: root.output-devices.length * 34px;
                                                    for d[i] in root.output-devices: Rectangle {
                                                        y: i * 34px;
                                                        height: 34px;
                                                        border-radius: 7px;
                                                        background: i == root.output-index ? Palette.accent-soft : (dta.has-hover ? Palette.hover : transparent);
                                                        Text {
                                                            x: 10px;
                                                            width: parent.width - 20px;
                                                            height: parent.height;
                                                            text: d;
                                                            color: i == root.output-index ? Palette.accent : Palette.text;
                                                            font-weight: i == root.output-index ? 600 : 400;
                                                            vertical-alignment: TextVerticalAlignment.center;
                                                            overflow: TextOverflow.elide;
                                                        }
                                                        dta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.output-picked(i);
                                                                out-popup.close();
                                                            }
                                                        }
                                                    }
                                                }
                                                ScrollThumb {
                                                    x: parent.width - self.width - 2px;
                                                    y: 5px;
                                                    height: parent.height - 10px;
                                                    content-h: dev-flick.content-height;
                                                    view-h: dev-flick.height;
                                                    content-y <=> dev-flick.content-y;
                                                }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: root.is-windows
                                                    ? (Lang.en ? "WASAPI exclusive mode" : "WASAPI 獨佔模式")
                                                    : (Lang.en ? "Exclusive mode" : "獨佔模式");
                                                color: Palette.strong;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: root.is-windows
                                                    ? (Lang.en ? "Sends each song at its own sample rate and bit depth (bit-perfect at 100% volume), bypassing the Windows mixer. Other apps can't play on this device meanwhile." : "開啟後依歌曲本身的取樣率與位元深度直接輸出（音量 100% 時為 bit-perfect），不經 Windows 混音；播放期間其他程式在這個裝置上會沒有聲音。")
                                                    : (Lang.en ? "Holds the output device for Simple Player alone (hog mode) and switches it to each song's own sample rate, so nothing is mixed or resampled (bit-perfect with the app and macOS volume at 100%). Other apps and system sounds can't play on this device meanwhile." : "開啟後由 Simple Player 獨佔輸出裝置（Hog Mode），並切換成每首歌本身的取樣率，不經混音也不做取樣率轉換（App 與 macOS 音量都在 100% 時為 bit-perfect）；播放期間其他程式和系統音效在這個裝置上會沒有聲音。");
                                                color: Palette.muted;
                                                font-size: 10px;
                                                wrap: TextWrap.word-wrap;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Toggle {
                                                checked <=> root.exclusive;
                                                toggled(on) => { root.exclusive-toggled(on); }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text { text: (Lang.en ? "Buffer size" : "緩衝大小"); color: Palette.strong; font-weight: 600; }
                                            Text {
                                                text: (Lang.en ? "Raise it if playback stutters. Bigger is steadier, but pause and seek react a little slower." : "播放會斷斷續續時調大；越大越穩，但暫停、跳轉的反應會慢一點。");
                                                color: Palette.muted;
                                                font-size: 10px;
                                                wrap: TextWrap.word-wrap;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 186px;
                                                height: 30px;
                                                border-radius: 15px;
                                                background: Palette.bg;
                                                border-width: 1px;
                                                border-color: Palette.line;
                                                HorizontalLayout {
                                                    padding: 3px;
                                                    spacing: 2px;
                                                    for opt[i] in (Lang.en ? ["Normal", "Large", "Max"] : ["標準", "大", "超大"]): Rectangle {
                                                        border-radius: 12px;
                                                        background: i == root.buffer-level ? Palette.accent : (bta.has-hover ? Palette.hover : transparent);
                                                        Text {
                                                            text: opt;
                                                            color: i == root.buffer-level ? Palette.accent-text : Palette.text;
                                                            font-size: 11px;
                                                            font-weight: i == root.buffer-level ? 600 : 400;
                                                            horizontal-alignment: TextHorizontalAlignment.center;
                                                            vertical-alignment: TextVerticalAlignment.center;
                                                        }
                                                        bta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.buffer-picked(i); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text { text: Lang.en ? "Volume levelling (ReplayGain)" : "音量平衡（ReplayGain）"; color: Palette.strong; font-weight: 600; }
                                            Text {
                                                text: Lang.en ? "Evens out loudness between songs or albums using the ReplayGain tags. Changes the samples, so it is not bit-perfect." : "依 ReplayGain 標籤讓歌曲或專輯之間音量一致；會改變音訊，開啟時不是 bit-perfect。";
                                                color: Palette.muted;
                                                font-size: 10px;
                                                wrap: TextWrap.word-wrap;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 186px;
                                                height: 30px;
                                                border-radius: 15px;
                                                background: Palette.bg;
                                                border-width: 1px;
                                                border-color: Palette.line;
                                                HorizontalLayout {
                                                    padding: 3px;
                                                    spacing: 2px;
                                                    for opt[i] in (Lang.en ? ["Off", "Track", "Album"] : ["關閉", "單曲", "專輯"]): Rectangle {
                                                        border-radius: 12px;
                                                        background: i == root.replaygain-mode ? Palette.accent : (rgta.has-hover ? Palette.hover : transparent);
                                                        Text {
                                                            text: opt;
                                                            color: i == root.replaygain-mode ? Palette.accent-text : Palette.text;
                                                            font-size: 11px;
                                                            font-weight: i == root.replaygain-mode ? 600 : 400;
                                                            horizontal-alignment: TextHorizontalAlignment.center;
                                                            vertical-alignment: TextVerticalAlignment.center;
                                                        }
                                                        rgta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.replaygain-picked(i); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: root.output-status == "" ? "" : (Lang.en ? "Current output: " : "目前輸出：") + root.output-status;
                                        color: Palette.faint;
                                        font-size: 10px;
                                        // long status (e.g. why the device refused a format) must wrap,
                                        // not widen the whole settings card
                                        wrap: TextWrap.word-wrap;
                                    }
                                }
                            }

                            // server
                            Rectangle {
                                border-radius: 12px;
                                background: Palette.raised;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout { alignment: center; Icon { name: "cloud"; size: 16px; color: Palette.accent; } }
                                        SectionLabel { text: (Lang.en ? "SIMPLE PLAYER SERVER" : "SIMPLE PLAYER 伺服器"); vertical-alignment: TextVerticalAlignment.center; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field {
                                            horizontal-stretch: 1;
                                            text <=> root.server-url;
                                            placeholder: (Lang.en ? "e.g. http://192.168.0.10:55555" : "例如 http://192.168.0.10:55555");
                                            accepted(t) => { root.save-server(t); }
                                        }
                                        VerticalLayout { alignment: center; Pill { label: (Lang.en ? "Connect" : "連線"); primary: true; clicked => { root.save-server(root.server-url); } } }
                                    }
                                    Text { text: root.server-status; color: Palette.muted; font-size: 11px; }
                                }
                            }

                            // folders
                            Rectangle {
                                border-radius: 12px;
                                background: Palette.raised;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout { alignment: center; Icon { name: "folder"; size: 16px; color: Palette.accent; } }
                                        SectionLabel { text: (Lang.en ? "Local music folders (subfolders become playlists)" : "本地音樂資料夾（子資料夾會成為歌單）"); vertical-alignment: TextVerticalAlignment.center; }
                                    }
                                    Rectangle {
                                        height: 100px;
                                        border-radius: 9px;
                                        background: Palette.bg;
                                        folder-list := ListView {
                                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                            for f[i] in root.folders: Rectangle {
                                                height: 36px;
                                                background: fta.has-hover ? Palette.hover : transparent;
                                                fta := TouchArea {}
                                                Text {
                                                    x: 12px;
                                                    width: parent.width - 56px;
                                                    height: parent.height;
                                                    text: f;
                                                    color: Palette.text;
                                                    vertical-alignment: TextVerticalAlignment.center;
                                                    overflow: TextOverflow.elide;
                                                }
                                                Glyph {
                                                    x: parent.width - 38px;
                                                    y: 2px;
                                                    icon: "trash";
                                                    size: 32px;
                                                    icon-size: 16px;
                                                    clicked => { root.remove-folder(i); }
                                                }
                                            }
                                        }
                                        ScrollThumb {
                                            x: parent.width - self.width;
                                            height: parent.height;
                                            content-h: folder-list.content-height;
                                            view-h: folder-list.visible-height;
                                            content-y <=> folder-list.content-y;
                                        }
                                        if root.folders.length == 0: Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: (Lang.en ? "No folders added yet" : "還沒有加入資料夾");
                                            color: Palette.faint;
                                            horizontal-alignment: TextHorizontalAlignment.center;
                                            vertical-alignment: TextVerticalAlignment.center;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Pill { label: (Lang.en ? "Add folder" : "新增資料夾"); icon: "plus"; clicked => { root.add-folder(); } }
                                        Pill { label: (Lang.en ? "Rescan" : "重新掃描"); icon: "refresh"; clicked => { root.rescan(); } }
                                    }
                                }
                            }

                            // discord
                            Rectangle {
                                border-radius: 12px;
                                background: Palette.raised;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: (Lang.en ? "Discord status" : "Discord 狀態"); color: Palette.strong; font-weight: 600; }
                                            Text { text: root.discord-status; color: Palette.muted; font-size: 10px; overflow: TextOverflow.elide; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Toggle {
                                                checked <=> root.discord-enabled;
                                                toggled(on) => { root.discord-toggled(on); }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field {
                                            horizontal-stretch: 1;
                                            text <=> root.public-url;
                                            placeholder: (Lang.en ? "Public https URL (for covers; empty = the server's publicOrigin)" : "公開 https 網址（封面用，留空＝用伺服器的 publicOrigin）");
                                            accepted(t) => { root.save-public-url(t); }
                                        }
                                        VerticalLayout { alignment: center; Pill { label: (Lang.en ? "Save" : "儲存"); clicked => { root.save-public-url(root.public-url); } } }
                                    }
                                    Text {
                                        text: (Lang.en ? "Discord can only show images from a public https URL; LAN http addresses can't show covers." : "Discord 只能顯示公開 https 網址上的圖片，區網 http 位址無法顯示封面。");
                                        color: Palette.faint;
                                        font-size: 10px;
                                        wrap: TextWrap.word-wrap;
                                    }
                                }
                            }
                        }
                    }
                    ScrollThumb {
                        x: parent.width - self.width;
                        height: parent.height;
                        content-h: settings-scroll.content-height;
                        view-h: settings-scroll.height;
                        content-y <=> settings-scroll.content-y;
                    }
                }
            }
        }
    }

    /* ---------- equalizer ---------- */
    if root.show-eq: Rectangle {
        background: Palette.scrim;
        TouchArea { clicked => { root.show-eq = false; keys.focus(); } }
        Rectangle {
            width: min(parent.width - 40px, 640px);
            height: min(parent.height - 40px, 780px);
            border-radius: 18px;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.line;
            drop-shadow-blur: 40px;
            drop-shadow-color: #00000070;
            TouchArea {}
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: (Lang.en ? "Equalizer" : "等化器"); font-size: 20px; font-weight: 700; color: Palette.strong; vertical-alignment: TextVerticalAlignment.center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.eq-enabled ? (Lang.en ? "On" : "開") : (Lang.en ? "Off" : "關");
                        color: Palette.muted;
                        font-size: 12px;
                        vertical-alignment: TextVerticalAlignment.center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            checked: root.eq-enabled;
                            toggled(on) => { root.eq-toggled(on); }
                        }
                    }
                    Rectangle { width: 4px; }
                    VerticalLayout { alignment: center; Glyph { icon: "close"; clicked => { root.show-eq = false; keys.focus(); } } }
                }
                Rectangle {
                    vertical-stretch: 1;
                    eq-scroll := Flickable {
                        content-height: eq-col.preferred-height;
                        eq-col := VerticalLayout {
                            width: eq-scroll.width - 12px;
                            spacing: 10px;

                            // presets
                            Rectangle {
                                border-radius: 12px;
                                background: Palette.raised;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    Text { text: Lang.en ? "Presets" : "設定檔"; color: Palette.strong; font-weight: 600; }
                                    chips := Flickable {
                                        height: 32px;
                                        content-width: max(chip-row.preferred-width, self.width);
                                        chip-row := HorizontalLayout {
                                            alignment: start;
                                            spacing: 6px;
                                            for name[i] in root.eq-presets: Rectangle {
                                                property <bool> on: i == root.eq-current;
                                                height: 30px;
                                                width: chip-text.preferred-width + 28px;
                                                border-radius: 15px;
                                                background: self.on ? Palette.accent : (chip-ta.has-hover ? Palette.hover : Palette.bg);
                                                border-width: self.on ? 0px : 1px;
                                                border-color: Palette.line;
                                                chip-text := Text {
                                                    text: name;
                                                    color: parent.on ? Palette.accent-text : Palette.text;
                                                    font-size: 12px;
                                                    font-weight: parent.on ? 600 : 400;
                                                    horizontal-alignment: TextHorizontalAlignment.center;
                                                    vertical-alignment: TextVerticalAlignment.center;
                                                }
                                                chip-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.eq-select(i); }
                                                }
                                            }
                                        }
                                    }
                                    if root.eq-dialog == 0 || root.eq-dialog == 1: HorizontalLayout {
                                        spacing: 8px;
                                        Field {
                                            horizontal-stretch: 1;
                                            text <=> root.eq-name;
                                            placeholder: root.eq-dialog == 0 ? (Lang.en ? "Name of the new preset" : "新設定檔的名稱") : (Lang.en ? "New name" : "新的名稱");
                                            accepted(t) => { root.eq-name-done(root.eq-dialog, t); }
                                        }
                                        VerticalLayout { alignment: center; Pill { label: Lang.en ? "OK" : "確定"; primary: true; clicked => { root.eq-name-done(root.eq-dialog, root.eq-name); } } }
                                        VerticalLayout { alignment: center; Pill { label: Lang.en ? "Cancel" : "取消"; clicked => { root.eq-dialog = -1; } } }
                                    }
                                    if root.eq-dialog == 2: HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: (Lang.en ? "Delete \"" : "刪除「") + root.eq-presets[root.eq-current] + (Lang.en ? "\"?" : "」？");
                                            color: Palette.strong;
                                            vertical-alignment: TextVerticalAlignment.center;
                                            overflow: TextOverflow.elide;
                                        }
                                        VerticalLayout { alignment: center; Pill { label: Lang.en ? "Delete" : "刪除"; primary: true; clicked => { root.eq-delete(); } } }
                                        VerticalLayout { alignment: center; Pill { label: Lang.en ? "Cancel" : "取消"; clicked => { root.eq-dialog = -1; } } }
                                    }
                                    if root.eq-dialog < 0: HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Pill { label: Lang.en ? "New" : "新增"; icon: "plus"; clicked => { root.eq-name = ""; root.eq-dialog = 0; } }
                                        Pill { label: Lang.en ? "Rename" : "重新命名"; clicked => { root.eq-name = root.eq-presets[root.eq-current]; root.eq-dialog = 1; } }
                                        Pill { label: Lang.en ? "Delete" : "刪除"; icon: "trash"; clicked => { root.eq-dialog = 2; } }
                                        Pill { label: Lang.en ? "Import" : "匯入"; icon: "folder"; clicked => { root.eq-import(); } }
                                        Pill { label: Lang.en ? "Export" : "匯出"; clicked => { root.eq-export(); } }
                                    }
                                    if root.eq-message != "": Text {
                                        text: root.eq-message;
                                        color: Palette.accent;
                                        font-size: 11px;
                                        wrap: TextWrap.word-wrap;
                                    }
                                    Text {
                                        text: Lang.en
                                            ? "Poweramp presets (.json) and AutoEq / Equalizer APO ParametricEQ.txt files can be imported; export writes Poweramp's format, which the Android app reads too."
                                            : "可以匯入 Poweramp 的設定檔（.json）和 AutoEq／Equalizer APO 的 ParametricEQ.txt；匯出是 Poweramp 格式，Android 版也能直接匯入。";
                                        color: Palette.muted;
                                        font-size: 10px;
                                        wrap: TextWrap.word-wrap;
                                    }
                                    if !root.eq-enabled: Text {
                                        text: Lang.en ? "The equalizer is off: turn on the switch at the top to hear it." : "等化器目前關閉，打開右上角的開關才會套用。";
                                        color: Palette.muted;
                                        font-size: 11px;
                                        wrap: TextWrap.word-wrap;
                                    }
                                }
                            }

                            // response curve
                            Rectangle {
                                border-radius: 12px;
                                background: Palette.raised;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 4px;
                                    curve := Rectangle {
                                        height: 170px;
                                        // ±6 / ±12 dB lines (±15 dB fills the height)
                                        for db in [-12, -6, 6, 12]: Rectangle {
                                            y: parent.height * (0.5 - db / 30) - 0.5px;
                                            height: 1px;
                                            background: Palette.line;
                                        }
                                        Rectangle {
                                            y: parent.height / 2 - 0.75px;
                                            height: 1.5px;
                                            background: Palette.faint;
                                        }
                                        // 50 100 200 500 1k 2k 5k 10k Hz
                                        for pos in [0.1323, 0.2330, 0.3333, 0.4660, 0.5667, 0.6667, 0.7993, 0.9000]: Rectangle {
                                            x: parent.width * pos;
                                            width: 1px;
                                            background: Palette.line;
                                        }
                                        Path {
                                            width: parent.width;
                                            height: parent.height;
                                            viewbox-width: 1000;
                                            viewbox-height: 300;
                                            commands: root.eq-curve;
                                            stroke: root.eq-enabled ? Palette.accent : Palette.muted;
                                            stroke-width: 2px;
                                            fill: transparent;
                                        }
                                        for d in root.eq-dots: Rectangle {
                                            x: parent.width * d.x - 4px;
                                            y: parent.height * d.y - 4px;
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: root.eq-enabled ? Palette.accent : Palette.muted;
                                        }
                                    }
                                    Rectangle {
                                        height: 14px;
                                        for label[i] in ["20", "100", "1k", "10k", "20k"]: Text {
                                            property <float> pos: [0, 0.2330, 0.5667, 0.9, 1][i];
                                            width: 30px;
                                            x: clamp(parent.width * self.pos - 15px, 0px, parent.width - 30px);
                                            horizontal-alignment: i == 0 ? TextHorizontalAlignment.left : (i == 4 ? TextHorizontalAlignment.right : TextHorizontalAlignment.center);
                                            text: label;
                                            color: Palette.muted;
                                            font-size: 10px;
                                        }
                                    }
                                    Text {
                                        text: Lang.en ? "±15 dB, preamp included" : "±15 dB，含前級";
                                        color: Palette.faint;
                                        font-size: 10px;
                                    }
                                }
                            }

                            // preamp
                            Rectangle {
                                border-radius: 12px;
                                background: Palette.raised;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: Lang.en ? "Preamp" : "前級"; color: Palette.strong; font-weight: 600; vertical-alignment: TextVerticalAlignment.center; }
                                        Slider {
                                            horizontal-stretch: 1;
                                            value: root.eq-preamp;
                                            moving(v) => { root.eq-preamp-moving(v); }
                                            committed(v) => { root.eq-preamp-committed(v); }
                                        }
                                        Text {
                                            width: 64px;
                                            text: root.eq-preamp-text;
                                            color: Palette.text;
                                            font-size: 12px;
                                            horizontal-alignment: TextHorizontalAlignment.right;
                                            vertical-alignment: TextVerticalAlignment.center;
                                        }
                                        VerticalLayout { alignment: center; Pill { label: Lang.en ? "Auto" : "自動"; clicked => { root.eq-auto-preamp(); } } }
                                    }
                                    Text {
                                        text: Lang.en
                                            ? "When a band boosts, lower the preamp by about as much so it doesn't clip. \"Auto\" works it out."
                                            : "有頻段加了增益時，前級要往下調差不多一樣多，才不會破音。按「自動」會幫你算。";
                                        color: Palette.muted;
                                        font-size: 10px;
                                        wrap: TextWrap.word-wrap;
                                    }
                                }
                            }

                            // bands
                            for band[i] in root.eq-bands: Rectangle {
                                border-radius: 12px;
                                background: Palette.raised;
                                VerticalLayout {
                                    padding: 14px;
                                    padding-top: 10px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: (Lang.en ? "Band " : "頻段 ") + (i + 1);
                                            color: Palette.strong;
                                            font-weight: 600;
                                            vertical-alignment: TextVerticalAlignment.center;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 246px;
                                                height: 28px;
                                                border-radius: 14px;
                                                background: Palette.bg;
                                                border-width: 1px;
                                                border-color: Palette.line;
                                                HorizontalLayout {
                                                    padding: 3px;
                                                    spacing: 2px;
                                                    for opt[k] in (Lang.en ? ["Low shelf", "Peak", "High shelf"] : ["低頻擱架", "峰值", "高頻擱架"]): Rectangle {
                                                        property <bool> on: k == band.kind;
                                                        border-radius: 11px;
                                                        background: self.on ? Palette.accent : (kta.has-hover ? Palette.hover : transparent);
                                                        Text {
                                                            text: opt;
                                                            color: parent.on ? Palette.accent-text : Palette.text;
                                                            font-size: 11px;
                                                            font-weight: parent.on ? 600 : 400;
                                                            horizontal-alignment: TextHorizontalAlignment.center;
                                                            vertical-alignment: TextVerticalAlignment.center;
                                                        }
                                                        kta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { if (!parent.on) { root.eq-band-kind(i, k); } }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        VerticalLayout { alignment: center; Glyph { size: 28px; icon-size: 16px; icon: "trash"; clicked => { root.eq-band-delete(i); } } }
                                    }
                                    for row[w] in [
                                        { label: Lang.en ? "Frequency" : "頻率", value: band.freq, text: band.freq-text },
                                        { label: Lang.en ? "Gain" : "增益", value: band.gain, text: band.gain-text },
                                        { label: "Q", value: band.q, text: band.q-text }
                                    ]: HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            width: 64px;
                                            text: row.label;
                                            color: Palette.text;
                                            font-size: 12px;
                                            vertical-alignment: TextVerticalAlignment.center;
                                        }
                                        Slider {
                                            horizontal-stretch: 1;
                                            value: row.value;
                                            moving(v) => { root.eq-band-moving(i, w, v); }
                                            committed(v) => { root.eq-band-committed(i, w, v); }
                                        }
                                        Text {
                                            width: 72px;
                                            text: row.text;
                                            color: Palette.text;
                                            font-size: 12px;
                                            horizontal-alignment: TextHorizontalAlignment.right;
                                            vertical-alignment: TextVerticalAlignment.center;
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Pill {
                                    label: root.eq-bands.length < root.eq-max-bands
                                        ? (Lang.en ? "Add band" : "新增頻段")
                                        : (Lang.en ? "At most " + root.eq-max-bands + " bands" : "最多 " + root.eq-max-bands + " 段");
                                    icon: "plus";
                                    clicked => { if (root.eq-bands.length < root.eq-max-bands) { root.eq-band-add(); } }
                                }
                            }
                            Rectangle { height: 6px; }
                        }
                    }
                    ScrollThumb {
                        x: parent.width - self.width;
                        height: parent.height;
                        content-h: eq-scroll.content-height;
                        view-h: eq-scroll.height;
                        content-y <=> eq-scroll.content-y;
                    }
                }
            }
        }
    }

    /* ---------- about ---------- */
    if root.show-about: Rectangle {
        background: Palette.scrim;
        TouchArea { clicked => { root.show-about = false; } }
        Rectangle {
            width: 440px;
            height: 520px;
            border-radius: 18px;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.line;
            drop-shadow-blur: 40px;
            drop-shadow-color: #00000070;
            TouchArea {}
            VerticalLayout {
                padding: 26px;
                spacing: 8px;
                HorizontalLayout {
                    alignment: center;
                    Image { width: 64px; height: 64px; source: @image-url("../assets/icon.png"); }
                }
                Text { text: "Simple Player for Windows"; font-size: 17px; font-weight: 700; color: Palette.strong; horizontal-alignment: TextHorizontalAlignment.center; }
                Text { text: "v" + root.app-version + "  ·  Apache License 2.0"; color: Palette.accent; font-size: 11px; font-weight: 600; horizontal-alignment: TextHorizontalAlignment.center; }
                Text { text: (Lang.en ? "Local music and Simple Player Web Server, with Discord status built in." : "本地音樂與 Simple Player Web Server，內建 Discord 狀態。"); color: Palette.muted; font-size: 11px; horizontal-alignment: TextHorizontalAlignment.center; wrap: TextWrap.word-wrap; }
                Text { text: Lang.en ? "Made by Akiraoo" : "Akiraoo 製作"; color: Palette.text; font-size: 12px; font-weight: 600; horizontal-alignment: TextHorizontalAlignment.center; }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: gh.preferred-width;
                        height: gh.preferred-height;
                        gh := Text {
                            text: "github.com/Akiraoo/SimplePlayer-Desktop-APP";
                            color: ghta.has-hover ? Palette.accent-hover : Palette.accent;
                            font-size: 11px;
                        }
                        ghta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-url("https://github.com/Akiraoo/SimplePlayer-Desktop-APP"); }
                        }
                    }
                }
                AboutSlint { height: 150px; }
                Text {
                    text: root.update-status;
                    visible: root.update-status != "";
                    color: root.update-available ? Palette.accent : Palette.muted;
                    font-size: 11px;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    wrap: TextWrap.word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    if root.update-available: Pill {
                        label: Lang.en ? "Download" : "前往下載";
                        primary: true;
                        clicked => { root.open-url(root.update-url); }
                    }
                    Pill {
                        label: root.update-checking ? (Lang.en ? "Checking…" : "檢查中…") : (Lang.en ? "Check for updates" : "檢查更新");
                        icon: "refresh";
                        clicked => { if (!root.update-checking) { root.check-update(); } }
                    }
                    Pill { label: (Lang.en ? "Close" : "關閉"); clicked => { root.show-about = false; } }
                }
            }
        }
    }
}

/* ---------------- detached player ---------------- */

export component PlayerWindow inherits Window {
    title: (Lang.en ? "Simple Player · Now playing" : "Simple Player · 正在播放");
    no-frame: true;
    always-on-top: root.pinned;
    preferred-width: 360px;
    preferred-height: 700px;
    min-width: 340px;
    min-height: 520px;
    background: Palette.surface;
    default-font-size: 12px;
    default-font-family: "Segoe UI";

    in-out property <bool> pinned: false;
    in property <string> now-title: (Lang.en ? "Nothing playing" : "尚未播放");
    in property <string> now-artist: (Lang.en ? "Pick a song to start" : "選一首歌開始播放");
    in property <string> now-album;
    in property <string> now-detail;
    in property <image> cover-image;
    in property <bool> has-cover: false;
    in property <bool> playing: false;
    in property <float> progress: 0;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <[LyricLine]> lyrics;
    in property <int> active-lyric: -1;
    in property <string> lyrics-state: (Lang.en ? "Waiting" : "等待播放");
    in property <bool> switching: false;
    callback toggle-play();
    callback prev();
    callback next();
    callback seek(float);
    callback lyric-clicked(int);
    callback attach();
    callback pin-toggled(bool);
    callback win-drag();
    callback win-minimize();
    callback win-resize(int);
    in property <bool> shuffle: false;
    in property <int> repeat-mode: 0;
    callback toggle-shuffle();
    callback cycle-repeat();
    callback seek-by(float);

    init => { pkeys.focus(); }
    pkeys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(e) => {
            if (e.text == " ") { root.toggle-play(); return accept; }
            if (e.text == Key.LeftArrow) {
                if (e.modifiers.control) { root.prev(); } else { root.seek-by(-5); }
                return accept;
            }
            if (e.text == Key.RightArrow) {
                if (e.modifiers.control) { root.next(); } else { root.seek-by(5); }
                return accept;
            }
            if (e.text == "s" || e.text == "S") { root.toggle-shuffle(); return accept; }
            if (e.text == "r" || e.text == "R") { root.cycle-repeat(); return accept; }
            return reject;
        }
    }

    VerticalLayout {
        // title bar
        Rectangle {
            height: 38px;
            background: Palette.titlebar;
            TouchArea {
                moved => {
                    if (self.pressed) { root.win-drag(); }
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Image { width: 18px; height: 18px; source: @image-url("../assets/icon-small.png"); }
                }
                Text {
                    text: (Lang.en ? "Now playing" : "正在播放");
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.text;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Glyph {
                        size: 28px;
                        icon-size: 16px;
                        icon: "pin";
                        active: root.pinned;
                        clicked => {
                            root.pinned = !root.pinned;
                            root.pin-toggled(root.pinned);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Glyph { size: 28px; icon-size: 16px; icon: "attach"; clicked => { root.attach(); } }
                }
                Rectangle { width: 4px; }
                WinButton { width: 42px; icon: "win-min"; clicked => { root.win-minimize(); } }
                WinButton { width: 42px; icon: "win-close"; danger: true; clicked => { root.attach(); } }
            }
        }

        NowPanel {
            vertical-stretch: 1;
            pad: 20px;
            art-size: 300px;
            cover-image: root.cover-image;
            has-cover: root.has-cover;
            now-title: root.now-title;
            now-artist: root.now-artist;
            now-album: root.now-album;
            now-detail: root.now-detail;
            lyrics: root.lyrics;
            active-lyric: root.active-lyric;
            lyrics-state: root.lyrics-state;
            switching: root.switching;
            lyric-clicked(i) => { root.lyric-clicked(i); }
        }

        // transport
        Rectangle {
            height: 104px;
            background: Palette.raised;
            Rectangle { y: 0; height: 1px; background: Palette.line; }
            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 12px;
                padding-bottom: 14px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 38px; text: root.position-text; color: Palette.muted; font-size: 10px; horizontal-alignment: TextHorizontalAlignment.right; vertical-alignment: TextVerticalAlignment.center; }
                    Slider {
                        horizontal-stretch: 1;
                        value: root.progress;
                        committed(v) => { root.seek(v); }
                    }
                    Text { width: 38px; text: root.duration-text; color: Palette.muted; font-size: 10px; vertical-alignment: TextVerticalAlignment.center; }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 12px;
                    VerticalLayout { alignment: center; Glyph { icon: "shuffle"; icon-size: 18px; size: 34px; active: root.shuffle; clicked => { root.toggle-shuffle(); } } }
                    VerticalLayout { alignment: center; Glyph { icon: "prev"; icon-size: 16px; size: 36px; clicked => { root.prev(); } } }
                    PlayButton { size: 48px; playing: root.playing; clicked => { root.toggle-play(); } }
                    VerticalLayout { alignment: center; Glyph { icon: "next"; icon-size: 16px; size: 36px; clicked => { root.next(); } } }
                    VerticalLayout { alignment: center; Glyph { icon: "repeat"; icon-size: 18px; size: 34px; active: root.repeat-mode > 0; badge: root.repeat-mode == 2 ? "1" : ""; clicked => { root.cycle-repeat(); } } }
                }
            }
        }
    }

    ResizeBorders {
        width: parent.width;
        height: parent.height;
        resize(d) => { root.win-resize(d); }
    }
}
